# ==========================================
# Ashare AI Strategy Analyst Docker 配置示例
# ==========================================

# ====== LLM API 配置 ======
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# DeepSeek thinking mode is opt-in for the tool-calling runtime.
LLM_THINKING_MODE=disabled

# ====== 监控与日志 ======
MONITOR_ENABLED=false
LOG_LEVEL=INFO
DEBUG=false

# ====== 数据路径 ======
# 容器内路径，docker-compose 已将宿主机 ./data 挂载到 /app/data
MONITOR_DB_PATH=/app/data/monitor.db

# ====== 可选在线股票搜索 ======
# 如需东方财富 suggest 补全，请在真实 .env 中配置，不要提交真实 token
EASTMONEY_TOKEN=

# ====== 同花顺 Fuyao（A 股）======
# Server-side only. Never expose this key to the browser or commit it.
# Without a key the adapter is inert and legacy Sina/Tencent/akshare paths are used.
FUYAO_API_KEY=
FUYAO_ENABLED=1
FUYAO_PRIMARY_A_SHARE=1
FUYAO_FINANCIALS=1

# ====== 同花顺 iFinD（quantapi，/bot 与 /work 共用）======
# Server-side only. Never expose this token to the browser or commit it.
# Without a token the adapter is inert and callers fall through to Fuyao/legacy.
IFIND_ACCESS_TOKEN=
IFIND_ENABLED=1
IFIND_PRIMARY=1
# Optional override; default is https://quantapi.51ifind.com/api/v1
# IFIND_DATA_API_BASE_URL=
# IFIND_HISTORY_DAYS=420

# ====== 美股数据源 ======
# 美股行情主源为 yfinance（无需 key）；Finnhub 作为备选源及美股新闻源。
# 未配置时仅用 yfinance，美股个股新闻会跳过。https://finnhub.io 免费注册获取 key
FINNHUB_API_KEY=

# ====== 可选推送配置 ======
SERVERCHAN_KEY=

# ====== Supabase workspace persistence (optional) ======
# Keep the service role key server-side only. Never expose it to Next.js/browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Legacy equivalent accepted by the backend:
SUPABASE_ANON_KEY=
# Optional: only needed for trusted backend jobs that intentionally bypass RLS.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REQUIRE_AUTH=true
SUPABASE_REQUEST_TIMEOUT_SECONDS=8

# ====== Hosted Beta invitation email (server-only) ======
RESEND_API_KEY=
RESEND_FROM_EMAIL=beta@your-domain.com
RESEND_FROM_NAME="Financial Bot"
NEXT_PUBLIC_SITE_URL=https://openashare.com

# Maximum model requests in one deep research execution (3–100; default 12).
FINANCIAL_BOT_DEEP_MODEL_REQUEST_LIMIT=12

# Per-run cumulative token stop for deep research. Leave unset/0/unlimited so a
# single research synthesis is never truncated by an app token budget. Output
# max_tokens on each model call stay separate. Set a positive integer only for
# emergency operator budgets.
# FINANCIAL_BOT_DEEP_TOTAL_TOKEN_LIMIT=0

# Cross-request research/agent call frequency (sliding window). Keys by owner,
# authenticated user, or client IP. Default: 30 starts per 3600 seconds.
# Set FINANCIAL_BOT_RESEARCH_RATE_LIMIT=0 to disable.
FINANCIAL_BOT_RESEARCH_RATE_LIMIT=30
FINANCIAL_BOT_RESEARCH_RATE_WINDOW_SECONDS=3600
